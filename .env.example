# ---------------------------------------------------------------------------
# Nexora backend - example environment file.
#
# Copy to `.env` for local development. NEVER commit a real `.env`.
# Every variable below is parsed and validated by src/app/config at startup;
# no other part of the codebase may read process.env.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# one of: development | test | production
NODE_ENV=development
APP_NAME=nexora-backend
# Namespace prefix isolating Redis keys per deployment. Must be unique per env.
APP_INSTANCE_NAMESPACE=local

# --- HTTP server -----------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Milliseconds the server waits for in-flight work during shutdown.
SERVER_SHUTDOWN_TIMEOUT_MS=15000
# Largest accepted request body, in bytes.
SERVER_BODY_LIMIT_BYTES=1048576
# Comma-separated exact origins. Empty means CORS is disabled (recommended for
# server-to-server deployments). Wildcards are intentionally not supported.
SERVER_CORS_ORIGINS=
# Trust `X-Request-Id` from callers. Enable ONLY when every client reaches the
# app through a trusted proxy that overwrites the header.
SERVER_TRUST_INCOMING_REQUEST_ID=false
SERVER_TRUST_PROXY=false

# --- PostgreSQL ------------------------------------------------------------
# Runtime uses the RLS-enforced application role (see migration 0030_rls_hardening.sql).
DATABASE_URL=postgresql://nexora_app:nexora@localhost:5433/nexora
# Elevated owner connection for migrations only. Omit to run migrations with DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://nexora:nexora@localhost:5433/nexora
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_SSL=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=nexora
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000

# --- Queue (BullMQ) --------------------------------------------------------
# BullMQ requires a Redis with `noeviction`; keep it separate from the cache in
# production so queue data never competes with cache eviction.
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=nexora-queue
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_BASE_MS=1000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_JOB_TIMEOUT_MS=30000

# --- Object storage (S3 / MinIO) -------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nexora-local
STORAGE_ACCESS_KEY_ID=nexora
STORAGE_SECRET_ACCESS_KEY=nexora-secret
# MinIO requires path-style addressing; most managed S3 services do not.
STORAGE_FORCE_PATH_STYLE=true

# --- Outbox ----------------------------------------------------------------
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10

# --- Idempotency -----------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400

# --- Observability ---------------------------------------------------------
# one of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs. Requires the `pino-pretty` dev dependency, so it must
# stay false in production images.
LOG_PRETTY=true
METRICS_ENABLED=true
TRACING_ENABLED=false
# Leave empty to keep traces in-process (no exporter, no backend required).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nexora-backend

# --- Outbound HTTP client --------------------------------------------------
HTTP_CLIENT_TIMEOUT_MS=10000

# --- Webhook delivery worker (Phase 6.4) -----------------------------------
# Hard timeout for outbound webhook HTTP requests.
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# Lease duration for DELIVERING rows before another worker may reclaim them.
WEBHOOK_DELIVERY_LEASE_SECONDS=300

# --- API documentation -----------------------------------------------------
# Serves the OpenAPI document and Scalar reference. Keep false in production
# unless the surface is deliberately public.
DOCS_ENABLED=true

# --- Authentication (Phase 2) --------------------------------------------
# Use HS256 secret for development, or PEM keys for asymmetric signing.
AUTH_JWT_SECRET=change-me-in-production-min-32-chars!!
# AUTH_JWT_PRIVATE_KEY=
# AUTH_JWT_PUBLIC_KEY=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Exactly 32 bytes for AES-256-GCM MFA secret encryption.
AUTH_MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
AUTH_STEP_UP_TTL_SECONDS=900
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
