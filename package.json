{
  "name": "nexora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora commerce/channel management platform",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.9.2",
  "main": "src/app/main.js",
  "scripts": {
    "build": "node scripts/check-syntax.mjs",
    "dev": "node --env-file=.env --import ./src/app/register-swc.mjs --watch src/app/main.js",
    "dev:nest": "node --env-file=.env src/nest/bootstrap.mjs",
    "dev:nest:watch": "node --env-file=.env --watch src/nest/bootstrap.mjs",
    "start:nest": "node --env-file=.env src/nest/bootstrap.mjs",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:jest:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:jest:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:vitest": "vitest run",
    "dev:worker": "node --env-file=.env --watch src/workers/main.js",
    "start": "node --env-file=.env --import ./src/app/register-swc.mjs src/app/main.js",
    "start:worker": "node --env-file=.env src/workers/main.js",
    "migrate": "node --env-file=.env src/app/bootstrap/migrate-cli.js up",
    "migrate:status": "node --env-file=.env src/app/bootstrap/migrate-cli.js status",
    "backfill:external-ids": "node --env-file=.env src/app/bootstrap/external-id-backfill-cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest watch --project unit",
    "verify": "npm run lint && npm run arch:check && npm run test:unit",
    "docs:route-inventory": "node scripts/audit-route-inventory.mjs",
    "docs:openapi-coverage": "node scripts/dump-openapi.mjs docs/.openapi-snapshot.json && node scripts/verify-openapi-route-coverage.mjs docs/.openapi-snapshot.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "express": "^4.21.2",
    "@aws-sdk/client-s3": "^3.700.0",
    "helmet": "^8.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/instrumentation-ioredis": "^0.47.0",
    "@opentelemetry/instrumentation-pg": "^0.51.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "otplib": "^13.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.11.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.8.0",
    "dotenv": "^18.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "@jest/globals": "^29.7.0",
    "@nestjs/testing": "^11.0.12",
    "@swc/jest": "^0.2.37",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
