{
  "name": "nexora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora commerce/channel management platform",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.9.2",
  "main": "src/app/main.js",
  "scripts": {
    "build": "node scripts/check-syntax.mjs",
    "dev": "node --watch src/app/main.js",
    "dev:worker": "node --watch src/workers/main.js",
    "start": "node src/app/main.js",
    "start:worker": "node src/workers/main.js",
    "migrate": "node src/app/bootstrap/migrate-cli.js up",
    "migrate:status": "node src/app/bootstrap/migrate-cli.js status",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest watch --project unit",
    "verify": "npm run lint && npm run arch:check && npm run test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/swagger": "^9.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/instrumentation-ioredis": "^0.47.0",
    "@opentelemetry/instrumentation-pg": "^0.51.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@scalar/fastify-api-reference": "^1.25.116",
    "argon2": "^0.45.1",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "otplib": "^13.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.8.0",
    "dotenv": "^18.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "vitest": "^3.2.7"
  }
}
