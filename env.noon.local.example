# TEMPLATE ONLY — copy to `.env.noon.local` (gitignored). Do NOT put real credentials in this file.
# Bootstrap does NOT read env.noon.local.example.
# Used with: node --env-file=.env --env-file=.env.noon.local --import ./src/app/register-swc.mjs scripts/dev-noon-connection-bootstrap.mjs
#
# Dedicated Noon channel (do not create another):
# WASL_NOON_CHANNEL_ID=c068bc73-e586-4512-94b9-e95f1121f0d5
#
# Pending from Noon account owner (bootstrap will fail until set):
# NOON_COUNTRY_CODE=ae|sa|eg
# NOON_WAREHOUSE_CODE=
#
# Service account — maps to POST …/marketplace-connection credentials (noon-config.js):
# NOON_KEY_ID=
# NOON_PROJECT_CODE=
# NOON_PRIVATE_KEY_PEM=     # full PEM; use \n for newlines in a single dotenv line
#
# Admin login for Wasl API (prefer sourcing from .env.stockconnect.local, not duplicating):
# WASL_ADMIN_PASSWORD=
#
# Reference only (not read by bootstrap or Wasl connection API):
# - credential type: apijwt
# - channel_identifier: from Noon credential bundle
# - issued_at: from Noon credential bundle
